// ─────────────────────────────────────────────────────────────────────────
// Prism — Niri configuration snippet
//
// Either paste the parts you want into ~/.config/niri/config.kdl, or keep
// this file next to your config and pull it in with (niri 25.11+):
//
//     include "prism-niri.kdl"
//
// Everything below is a suggestion; rebind freely. The shell is controlled by
// `qs -c prism ipc call <target> <method>` (run
// `qs -c prism ipc call help display` for the full list).
// ─────────────────────────────────────────────────────────────────────────

// Start the shell with niri. (Under niri-session you can instead run it as a
// systemd user service; either way, start it exactly once.)
spawn-at-startup "qs" "-c" "prism"

// Where niri's built-in screenshot UI saves files.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

binds {
    // ── Shell ────────────────────────────────────────────────────────────
    Mod+Space         hotkey-overlay-title="App Launcher"        { spawn "qs" "-c" "prism" "ipc" "call" "launcher"    "toggle"; }
    Mod+Shift+Space   hotkey-overlay-title="Spotlight Search"    { spawn "qs" "-c" "prism" "ipc" "call" "search"      "toggle"; }
    Mod+Alt+W         hotkey-overlay-title="Wallpaper Picker"    { spawn "qs" "-c" "prism" "ipc" "call" "wallpaper"   "toggle"; }
    Mod+Alt+V         hotkey-overlay-title="Clipboard History"   { spawn "qs" "-c" "prism" "ipc" "call" "clipboard"   "toggle"; }
    Mod+Alt+E         hotkey-overlay-title="Emoji Picker"        { spawn "qs" "-c" "prism" "ipc" "call" "emoji"       "toggle"; }
    Mod+Alt+C         hotkey-overlay-title="Color Picker"        { spawn "qs" "-c" "prism" "ipc" "call" "colorpicker" "toggle"; }
    Mod+Alt+N         hotkey-overlay-title="Notification Center" { spawn "qs" "-c" "prism" "ipc" "call" "notif"       "toggle"; }
    Mod+Alt+Comma     hotkey-overlay-title="Settings"            { spawn "qs" "-c" "prism" "ipc" "call" "settings"    "toggle"; }
    Mod+Alt+P         hotkey-overlay-title="Power Menu"          { spawn "qs" "-c" "prism" "ipc" "call" "power"       "toggle"; }
    Mod+Alt+Slash     hotkey-overlay-title="Keybind Viewer"      { spawn "qs" "-c" "prism" "ipc" "call" "keybinds"    "toggle"; }
    Mod+Alt+Delete    hotkey-overlay-title="Lock Screen"         { spawn "qs" "-c" "prism" "ipc" "call" "lock"        "lock"; }

    // ── Recovery ─────────────────────────────────────────────────────────
    // Restart Quickshell if it crashes while the session is locked. Because of
    // ext-session-lock-v1 a new client can take over an existing lock.
    // allow-when-locked is what makes this bind work on the lock screen.
    Mod+Shift+Escape allow-when-locked=true hotkey-overlay-title=null { spawn-sh "killall qs; qs -c prism"; }
}

