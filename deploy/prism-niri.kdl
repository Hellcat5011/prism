// ─────────────────────────────────────────────────────────────────────────
// Prism (Rust) — Niri configuration snippet
//
// Include from ~/.config/niri/config.kdl:
//     include "prism-niri.kdl"
// ─────────────────────────────────────────────────────────────────────────

// prismd is started by the systemd user unit (deploy/prismd.service); do not
// also spawn it here (a second launcher orphaned a duplicate desktop layer).

binds {
    // ── Shell Overlays ────────────────────────────────────────────────────
    Mod+Space         hotkey-overlay-title="App Launcher"        { spawn "prism-ctl" "launcher"    "toggle"; }
    Mod+Shift+Space   hotkey-overlay-title="Spotlight Search"    { spawn "prism-ctl" "search"      "toggle"; }
    Mod+Alt+W         hotkey-overlay-title="Wallpaper Picker"    { spawn "prism-ctl" "wallpaper"   "toggle"; }
    Mod+Alt+V         hotkey-overlay-title="Clipboard History"   { spawn "prism-ctl" "clipboard"   "toggle"; }
    Mod+Alt+E         hotkey-overlay-title="Emoji Picker"        { spawn "prism-ctl" "emoji"       "toggle"; }
    Mod+Alt+C         hotkey-overlay-title="Color Picker"        { spawn "prism-ctl" "colorpicker" "toggle"; }
    Mod+Alt+N         hotkey-overlay-title="Notification Center" { spawn "prism-ctl" "notif"       "toggle"; }
    Mod+Alt+Comma     hotkey-overlay-title="Settings"            { spawn "prism-ctl" "settings"    "toggle"; }
    Mod+Alt+P         hotkey-overlay-title="Power Menu"          { spawn "prism-ctl" "power"       "toggle"; }
    Mod+Alt+Slash     hotkey-overlay-title="Keybind Viewer"      { spawn "prism-ctl" "keybinds"    "toggle"; }
    Mod+Alt+Delete    hotkey-overlay-title="Lock Screen"         { spawn "prism-ctl" "lock"        "lock"; }

    // ── Hardware OSD ──────────────────────────────────────────────────────
    XF86AudioRaiseVolume  { spawn "prism-ctl" "osd" "volume" "+5"; }
    XF86AudioLowerVolume  { spawn "prism-ctl" "osd" "volume" "-5"; }
    XF86MonBrightnessUp   { spawn "prism-ctl" "osd" "brightness" "+5"; }
    XF86MonBrightnessDown { spawn "prism-ctl" "osd" "brightness" "-5"; }
}
