# Prism: let members of the wheel group set the battery charge limit
# (Settings > System > Charge Limit) without a password prompt.
ACTION=="add|change", SUBSYSTEM=="power_supply", KERNEL=="BAT*", TEST=="charge_control_end_threshold", RUN+="/bin/sh -c 'chgrp wheel /sys%p/charge_control_end_threshold && chmod g+w /sys%p/charge_control_end_threshold'"
