{
  "manifest_version": 3,
  "name": "Prism Downloads",
  "version": "0.1.3",
  "description": "Hands your downloads to the Prism desktop shell: faster downloads over several connections, pause and resume, even after a restart.",
  "homepage_url": "https://github.com/Hellcat5011/prism",
  "browser_specific_settings": {
    "gecko": {
      "id": "downloads@prism-shell",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["downloads", "nativeMessaging", "cookies", "contextMenus", "storage", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Prism Downloads",
    "default_popup": "popup.html",
    "default_icon": "icons/toolbar.svg"
  },
  "options_ui": { "page": "options.html" },
  "icons": { "48": "icons/prism.svg", "96": "icons/prism.svg" }
}
